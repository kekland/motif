{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "app",
      "program": "app/lib/main.dart",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--enable-impeller"
      ]
    },
    {
      "name": "app (wasm)",
      "program": "app/lib/main.dart",
      "request": "launch",
      "type": "dart",
      "toolArgs": [
        "--wasm"
      ]
    },
    {
      "name": "app (profile)",
      "program": "app/lib/main.dart",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "toolArgs": [
        "--enable-impeller"
      ]
    },
    {
      "name": "app (release)",
      "program": "app/lib/main.dart",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release"
    },
    {
      "name": "server",
      "program": "server/lib/main.dart",
      "request": "launch",
      "type": "dart"
    },
    {
      "name": "Flutter (lib/utils/typedefs.dart)",
      "type": "dart",
      "request": "launch",
      "cwd": "packages/ui",
      "program": "lib/utils/typedefs.dart"
    }
  ]
}