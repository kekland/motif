{
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "**/flutter/ephemeral": true,
    "**/Flutter/ephemeral": true,
    "**/.symlinks": true,
    "**/.plugin_symlinks": true,
    ".fvm": true,
    ".fvmrc": true,
    "**/.dart_tool": true,
    "**/.idea": true,
    "**/*.iml": true,
    "**/.metadata": true,
    "**/pubspec.lock": true,
    "build": true,
    "**/__pycache__": true,
    "**/.flutter-plugins-dependencies": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true,
    "**/.dart_tool": true,
    "packages/skia/build/skia": true,
    "__archive__/**": true
  },
  "files.watcherExclude": {
    ".git/objects/**": true,
    ".git/subtree-cache/**": true,
    ".hg/store/**": true,
    "*/.git/objects/**": true,
    "*/.git/subtree-cache/**": true,
    "*/.hg/store/**": true,
    "**/.dart_tool": true,
    "packages/skia/build/skia": true,
    "__archive__/**": true
  },
  "dart.flutterSdkPath": ".fvm/versions/master",
  "editor.rulers": [
    120
  ],
  "material-icon-theme.folders.associations": {
    "editor": "container"
  }
}